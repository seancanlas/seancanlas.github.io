---
import { t, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const entries = ['early', 'robotics', 'dawson', 'concordia', 'current'] as const
---

<section id="background" class="scroll-mt-20 border-t border-border-subtle bg-bg-base py-16 sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-3">
        <h2 class="font-display text-3xl tracking-tight text-text-primary sm:text-4xl">
          {t(locale, 'about.heading')}
        </h2>
      </div>

      <div class="lg:col-span-9">
        <p class="max-w-2xl text-lg leading-relaxed text-text-secondary">
          {t(locale, 'about.intro')}
        </p>

        <div class="mt-8 max-w-2xl border-l-2 border-accent pl-5">
          <p class="font-mono text-xs text-text-muted">{t(locale, 'about.nowLabel')}</p>
          <p class="mt-1 text-sm leading-relaxed text-text-primary">{t(locale, 'about.nowText')}</p>
        </div>

        <ol class="mt-12 border-t border-border-subtle">
          {
            entries.map((key) => (
              <li class="grid gap-1 border-b border-border-subtle py-6 sm:grid-cols-6 sm:gap-6">
                <p class="font-mono text-xs text-text-muted sm:col-span-2">
                  {t(locale, `about.entries.${key}.year`)}
                </p>
                <div class="sm:col-span-4">
                  <h3 class="text-sm font-medium text-text-primary">
                    {t(locale, `about.entries.${key}.title`)}
                  </h3>
                  <p class="mt-1 text-sm leading-relaxed text-text-secondary">
                    {t(locale, `about.entries.${key}.body`)}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
