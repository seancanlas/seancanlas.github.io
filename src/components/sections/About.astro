---
import { t, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const fr = locale === 'fr'
const entries = ['current','concordia','dawson']
---
<section id="background" class="background section"><div class="container background-grid"><div><h2>{fr ? 'Curieux de nature. Ingénieur par formation.' : 'Curious by nature. Engineer by training.'}</h2><p class="section-description">{t(locale,'about.intro')}</p><a class="text-link" href="https://ca.linkedin.com/in/seancanlas" target="_blank" rel="noopener noreferrer">{fr ? 'Retrouvez-moi sur LinkedIn' : 'Find me on LinkedIn'} <span aria-hidden="true">↗</span></a></div><div class="experience-list">{entries.map(key => <article class="experience"><div class="experience-heading"><h3>{t(locale,`about.entries.${key}.title`)}</h3><p class="experience-date">{t(locale,`about.entries.${key}.year`)}</p></div><p>{t(locale,`about.entries.${key}.body`)}</p></article>)}</div></div></section>
