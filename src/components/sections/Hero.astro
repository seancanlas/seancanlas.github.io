---
import { Image } from 'astro:assets'
import profile from '@/assets/profile.jpg'
import Button from '@/components/ui/Button.astro'
import { t, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const facts = [
  { label: t(locale, 'hero.facts.currentlyLabel'), value: t(locale, 'hero.facts.currentlyValue') },
  { label: t(locale, 'hero.facts.focusLabel'), value: t(locale, 'hero.facts.focusValue') },
  { label: t(locale, 'hero.facts.basedLabel'), value: t(locale, 'hero.facts.basedValue') },
  { label: t(locale, 'hero.facts.sinceLabel'), value: t(locale, 'hero.facts.sinceValue') },
]
---

<section id="hero" class="pt-28 pb-16 sm:pt-36 sm:pb-24" aria-labelledby="hero-title">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-8">
      <div class="hero-enter lg:col-span-7">
        <p class="font-mono text-xs text-accent">{t(locale, 'hero.eyebrow')}</p>

        <h1
          id="hero-title"
          class="mt-5 font-display text-fluid-4xl leading-display tracking-tight text-text-primary text-balance"
        >
          {t(locale, 'hero.title')}
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">
          {t(locale, 'hero.intro')}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="#portfolio" size="lg">{t(locale, 'hero.workCta')}</Button>
          <Button href="#contact" variant="outline" size="lg">{t(locale, 'hero.contactCta')}</Button>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-border-subtle pt-8 sm:grid-cols-4">
          {
            facts.map((fact) => (
              <div>
                <dt class="font-mono text-xs text-text-muted">{fact.label}</dt>
                <dd class="mt-1 text-sm text-text-primary">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero-enter hero-enter-delay-2 lg:col-span-5">
        <div class="mx-auto max-w-72 overflow-hidden border border-border-subtle bg-bg-elevated sm:max-w-sm lg:ml-auto lg:mr-0">
          <Image
            src={profile}
            alt={t(locale, 'hero.portraitAlt')}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 32vw, 100vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="aspect-4/5 h-full w-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </div>
</section>
