---
import { Image } from 'astro:assets'
import profile from '@/assets/profile.jpg'
import { t, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const fr = locale === 'fr'
---
<section id="hero" class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">{fr ? 'Des logiciels solides. Du début à la production.' : 'Thoughtful software. Built for the real world.'}</h1>
    <p class="hero-description">{fr ? 'Je suis Sean, développeur full-stack spécialisé en backend. Je construis des API fiables, des moteurs de recherche rapides et des applications utiles.' : 'I’m Sean, a full-stack developer with a backend focus. I build reliable APIs, fast search systems, and useful applications.'}</p>
    <div class="hero-actions"><a class="button" href="#portfolio">{t(locale, 'hero.workCta')} <span aria-hidden="true">↘</span></a><a class="text-link" href="#contact">{t(locale, 'hero.contactCta')}</a></div>
  </div>
  <figure class="hero-portrait">
    <Image
      src={profile}
      alt={t(locale, 'hero.portraitAlt')}
      width={960}
      height={960}
      widths={[360, 480, 720, 960]}
      sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1000px) 38vw, 420px"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</section>
