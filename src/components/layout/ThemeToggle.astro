---
import Icon from '@/components/ui/Icon.astro'
import { t, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<button
  type="button"
  data-theme-toggle
  data-label-light={t(locale, 'footer.themeToggle.light')}
  data-label-dark={t(locale, 'footer.themeToggle.dark')}
  aria-label={t(locale, 'footer.themeToggle.dark')}
  aria-pressed="false"
  class="icon-button"
>
  <span class="theme-icon-moon"><Icon name="moon" size={18} /></span>
  <span class="theme-icon-sun"><Icon name="sun" size={18} /></span>
</button>
