---
import Icon from '@/components/ui/Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { t, paths, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const base = paths[locale]
const items = [
  { href: `${base}#portfolio`, label: t(locale, 'nav.work') },
  { href: `${base}#background`, label: t(locale, 'nav.background') },
  { href: `${base}#contact`, label: t(locale, 'nav.contact') },
]
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-bg-deep transition-colors duration-200 data-[scrolled]:border-border-subtle"
>
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a
      href={paths[locale]}
      class="font-display text-lg tracking-tight text-text-primary transition-colors duration-150 hover:text-accent"
    >
      Sean Canlas
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
      {
        items.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="rounded-sm px-3 py-2 text-sm text-text-secondary transition-colors duration-150 hover:text-text-primary data-[active]:text-text-primary"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <LanguageSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <button
        type="button"
        data-menu-toggle
        data-label-open={t(locale, 'nav.openMenu')}
        data-label-close={t(locale, 'nav.closeMenu')}
        aria-label={t(locale, 'nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-sm text-text-secondary transition-colors duration-150 hover:bg-bg-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-deep sm:hidden"
      >
        <span class="menu-icon-open inline-flex"><Icon name="menu" size={20} /></span>
        <span class="menu-icon-close"><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu hidden class="border-t border-border-subtle bg-bg-deep sm:hidden">
    <nav class="mx-auto w-full max-w-6xl px-5 py-3" aria-label="Primary mobile">
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-11 items-center rounded-sm px-2 text-base text-text-secondary transition-colors duration-150 hover:bg-bg-hover hover:text-text-primary"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
