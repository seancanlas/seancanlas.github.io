---
import ThemeToggle from './ThemeToggle.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { t, paths, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const items = [{id:'portfolio',key:'work'},{id:'background',key:'background'},{id:'contact',key:'contact'}]
---
<header data-header class="site-header">
  <div class="container nav-bar">
    <a href={paths[locale]} class="wordmark"><span class="monogram">sc<span>.</span></span><span>Sean Canlas</span></a>
    <nav class="desktop-nav" aria-label="Primary">{items.map(item => <a href={`${paths[locale]}#${item.id}`} data-nav-link>{t(locale,`nav.${item.key}`)}</a>)}</nav>
    <div class="nav-controls"><LanguageSwitcher locale={locale}/><ThemeToggle locale={locale}/><button class="menu-toggle icon-button" data-menu-toggle data-label-open={t(locale,'nav.openMenu')} data-label-close={t(locale,'nav.closeMenu')} aria-label={t(locale,'nav.openMenu')} aria-expanded="false" aria-controls="mobile-menu"><span aria-hidden="true">☰</span></button></div>
  </div>
  <nav id="mobile-menu" data-menu hidden aria-label="Primary mobile" class="mobile-nav container">{items.map(item => <a href={`${paths[locale]}#${item.id}`}>{t(locale,`nav.${item.key}`)}</a>)}</nav>
</header>
