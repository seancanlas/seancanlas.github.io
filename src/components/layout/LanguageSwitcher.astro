---
import { alternateLocale, languageTag, paths, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const next = alternateLocale(locale)
const label = next === 'fr' ? 'Français' : 'English'
---

<a
  href={paths[next]}
  hreflang={languageTag(next)}
  lang={languageTag(next)}
  aria-label={label}
  class="inline-flex h-11 min-w-11 items-center justify-center rounded-sm px-2 font-mono text-xs uppercase tracking-wider text-text-secondary transition-colors duration-150 hover:bg-bg-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-deep"
>
  {next}
</a>
