---
import { alternateLocale, languageTag, paths, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const next = alternateLocale(locale)
const label = next === 'fr' ? 'Français' : 'English'
---

<a
  href={paths[next]}
  hreflang={languageTag(next)}
  lang={languageTag(next)}
  aria-label={label}
  class="language-link"
>
  {next}
</a>
