---
import { socialLinks } from '@/lib/constants'
import { t, type Locale } from '@/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
---
<footer class="site-footer container"><p>© {new Date().getFullYear()} Sean Canlas</p><nav aria-label="Elsewhere">{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}<a href="https://github.com/seancanlas/seancanlas.github.io" target="_blank" rel="noopener noreferrer">{t(locale,'footer.source')}</a></nav></footer>
