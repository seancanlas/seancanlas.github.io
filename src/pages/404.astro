---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/ui/Button.astro'
---

<BaseLayout
  locale="en"
  title="Page not found — Sean Canlas"
  description="This page does not exist."
  noindex
>
  <section class="flex min-h-128 items-center py-24">
    <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
      <p class="font-mono text-xs text-accent">404</p>
      <h1 class="mt-4 font-display text-fluid-3xl tracking-tight text-text-primary">
        This page does not exist.
      </h1>
      <p class="mt-4 max-w-md text-base text-text-secondary">
        The link may be outdated, or the page may have moved. Both language versions of the site are
        still here.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/" size="lg">Back to the homepage</Button>
        <Button href="/fr/" variant="outline" size="lg">Version française</Button>
      </div>
    </div>
  </section>
</BaseLayout>
